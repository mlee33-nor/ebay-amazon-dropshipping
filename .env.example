# Ask AI (optional): Claude. ANTHROPIC_API_KEY is an API key (sk-ant-api03-...); the question and the figures behind each
# answer are sent to Anthropic. ANTHROPIC_MODEL defaults to claude-sonnet-5-5; claude-haiku-5-5 is cheaper and faster.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only for an organization-level key (one not created inside a workspace): the workspace ID, wrkspc_...
ANTHROPIC_WORKSPACE_ID=
