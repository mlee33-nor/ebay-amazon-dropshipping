EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_BACKFILL_DAYS=365
SYNC_INTERVAL_MINUTES=30
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DASHBOARD_PASSWORD=
SESSION_SECRET=

EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_BACKFILL_DAYS=120
INBOUND_TOKEN=
SYNC_INTERVAL_MINUTES=30
EBAY_RUNAME=
DB_SCHEMA=dropship

# Ask AI (optional): an OpenAI-compatible model that reads questions the built-in reader can't place.
# Only the question text is sent to it. It must be reachable from the server: a 127.0.0.1 address on your PC isn't, but a Tailscale address is once TS_AUTHKEY is set.
AI_API_BASE=
AI_API_KEY=
AI_MODEL=auto
# Tailscale (optional): join your tailnet so the server can reach a model on your own PC (see README, Ask AI).
TS_AUTHKEY=
# With Tailscale, use the PC's Tailscale IP in AI_API_BASE (http://100.x.y.z/v1) and its name here: the proxy can't look up tailnet names.
AI_HOST=
